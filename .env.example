# Copy to .env and fill in. .env is gitignored.
#
# Host-side (bun run dev, scripts): the shared Postgres publishes on 127.0.0.1 (never "localhost").
# Inside Docker (docker-compose.yml): the host is the container name, "postgres".
DATABASE_URL=postgresql://mainframe:CHANGE_ME@127.0.0.1:5432/water_tracker
POSTGRES_PASSWORD=CHANGE_ME

# Optional: LAN or Tailscale address the phone uses; only affects the deploy script's printed URL.
PHONE_HOST=
