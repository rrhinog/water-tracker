# Copy to .env and fill in. .env is gitignored. Placeholders only here.
#
# Two views of the same Postgres:
#   - containers (docker-compose.yml) reach it by its container name:  postgres:5432
#   - the host (bun run dev, scripts/migrate.ts, scripts/seed-demo.ts) reaches it on 127.0.0.1:5432
#     (never "localhost")
# Live and staging each have their own database; staging holds demo data only.

# Containers: the URL each container uses as its DATABASE_URL.
LIVE_DATABASE_URL=postgresql://APP_USER:CHANGE_ME@postgres:5432/water_tracker
STAGING_DATABASE_URL=postgresql://APP_USER:CHANGE_ME@postgres:5432/water_tracker_staging

# Host: the same two databases, for `bun scripts/migrate.ts live|staging` and the seed script.
# deploy.ps1 migrates the target's database with these before recreating its container.
LIVE_DATABASE_URL_FROM_HOST=postgresql://APP_USER:CHANGE_ME@127.0.0.1:5432/water_tracker
STAGING_DATABASE_URL_FROM_HOST=postgresql://APP_USER:CHANGE_ME@127.0.0.1:5432/water_tracker_staging

# Host: `bun run dev` and scripts run without a target. Point it at staging (or a *_demo database),
# not live, so local development never writes to real data.
DATABASE_URL=postgresql://APP_USER:CHANGE_ME@127.0.0.1:5432/water_tracker_staging

# Optional: LAN or Tailscale address the phone uses; only affects the deploy script's printed URL.
PHONE_HOST=
# Optional: your machine's Tailscale HTTPS name (e.g. mypc.tailnet-name.ts.net), used by deploy.ps1
TS_HTTPS_HOST=
